# Copie este arquivo para .env.local e preencha com os valores reais.

# Connection string do seu banco Neon (Console Neon > Connection Details > "Prisma" ou "Connection string")
# Formato: postgresql://usuario:senha@host/nome_do_banco?sslmode=require
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.neon.tech/previna?sslmode=require"

# Chave secreta para assinar o cookie de sessão. Gere uma qualquer, por exemplo com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-uma-chave-aleatoria-grande"
